# 应用配置
APP_NAME=FastAPI Starter
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# 数据库配置 (MySQL 示例，也可使用 PostgreSQL/SQLite)
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fastapi_starter?charset=utf8mb4
# PostgreSQL 示例: postgresql+psycopg2://user:password@localhost:5432/dbname
# SQLite 示例: sqlite:///./test.db

# JWT 配置
JWT_SECRET_KEY=your-super-secret-key-change-in-production-please
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# CORS 配置
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
